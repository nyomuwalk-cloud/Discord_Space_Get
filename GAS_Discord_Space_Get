// 設定スプレッドシートの行を読み込む
function getConfigRows() {
  const spreadsheetId = CONFIG_SPREADSHEET_ID || ensureConfigSpreadsheet();
  const ss = SpreadsheetApp.openById(spreadsheetId);
  const sheet = ss.getSheetByName(CONFIG_SHEET_NAME);
  if (!sheet) {
    throw new Error('シート「' + CONFIG_SHEET_NAME + '」が見つかりません。');
  }

  const data = sheet.getDataRange().getValues();
  if (data.length < 2) return [];

  const rows = [];
  for (let i = 1; i < data.length; i++) {
    const row = {};
    CONFIG_HEADERS.forEach((header, index) => {
      row[header] = data[i][index];
    });
    rows.push(row);
  }
  return rows;
}

// 設定スプレッドシートが存在しない場合は自動作成
function ensureConfigSpreadsheet() {
  const existingId = PropertiesService.getScriptProperties().getProperty('configSpreadsheetId');
  if (existingId) {
    try {
      SpreadsheetApp.openById(existingId);
      return existingId;
    } catch (e) {
      console.warn('保存済みのスプレッドシートIDが無効です。再作成します。');
    }
  }

  const ss = SpreadsheetApp.create('Discord_Space_Get_Config');
  const sheet = ss.getSheetByName('Sheet1');
  if (sheet) {
    sheet.setName(CONFIG_SHEET_NAME);
  }
  sheet.appendRow(CONFIG_HEADERS);

  PropertiesService.getScriptProperties().setProperty('configSpreadsheetId', ss.getId());
  console.log('設定スプレッドシートを作成しました: ' + ss.getUrl());
  console.log('Const.gs の CONFIG_SPREADSHEET_ID に以下のIDを設定してください: ' + ss.getId());

  return ss.getId();
}
