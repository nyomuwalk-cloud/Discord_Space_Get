// ブックマークをリセット（次回実行で最新位置のみ再設定）
function resetBookmark() {
  const spreadsheetId = CONFIG_SPREADSHEET_ID || ensureConfigSpreadsheet();
  const ss = SpreadsheetApp.openById(spreadsheetId);
  const sheet = ss.getSheetByName(CONFIG_SHEET_NAME);
  if (!sheet) {
    throw new Error('シート「' + CONFIG_SHEET_NAME + '」が見つかりません。');
  }

  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    sheet.getRange(i + 1, 6).clearContent();
  }
  console.log('全行のブックマーク（F列）をリセットしました。');
}

// 転送済みキャッシュをクリア
function clearForwardedCache() {
  PropertiesService.getScriptProperties().deleteProperty(PROP_FORWARDED_SPACE_IDS);
  console.log('転送済みキャッシュをクリアしました。');
}

// 手動で直近 N 件をテスト転送（ブックマークは変更しない）
function dryRunRecent(count = 10) {
  const rows = getConfigRows();
  if (!rows.length) {
    throw new Error('有効な設定がありません。スプレッドシートを確認してください。');
  }
  const row = rows.find(r => r.enabled) || rows[0];
  if (!row.sourceChannelId) {
    throw new Error('sourceChannelId が設定されていません。');
  }
  const sourceChannelId = String(row.sourceChannelId);
  const messages = fetchMessages(sourceChannelId, null, count);
  let found = 0;
  messages.forEach((m) => {
    const info = detectSpace(m);
    if (info) {
      found++;
      console.log(`[スペース検出] ${info.spaceUrl} | 本文: ${(m.content || '').slice(0, 80)}`);
    }
  });
  console.log(`直近 ${messages.length} 件中、スペース投稿は ${found} 件でした（転送は行いません）。`);
}

